FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff AS build
WORKDIR /src
COPY engine.cpp output.hpp ./
RUN g++ -std=c++17 -O3 -DNDEBUG -pthread -static-libstdc++ -static-libgcc -s engine.cpp -o /engine
FROM scratch AS artifact
COPY --from=build /engine /app/engine
FROM debian:bookworm-slim
COPY --from=artifact /app/engine /app/engine
USER 1000:1000
ENTRYPOINT ["/app/engine"]
